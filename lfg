#!/usr/bin/env -S python3 -I
"""lfg: keep the Mac awake with the lid shut (and the screen unlocked) for a few
hours, then put sleep and the screen lock back.

  lfg            on for 3 hours. Already on? Shows when it started, when it
                 ends and how long is left, then: add 3 h, add 6 h, add any
                 number of hours (Custom), turn off, or leave it.
  lfg 6          on for 6 hours from now (never cuts a longer run short)
  lfg +2         add 2 hours to the current end
  lfg 0 | off    off now: sleep and the screen lock come back
  lfg status     say whether it is on; changes nothing
  lfg setup      never ask for the password again (asks it one last time;
                 lfg setup --undo asks again)
  lfg update     get the newest lfg
  lfg uninstall  remove lfg from this Mac

Your Mac password is asked once, only to start or to stop. Extending needs no password, so an agent can
extend it while you are away (`lfg +3`).

How it works: one time on disk (~/.lfg/until) says when it ends. Two small background loops read it every
20 seconds: one (run as admin) turns lid sleep back on when the time has passed, the other keeps the Mac
awake until then and, at the end, opens a Terminal window asking for the password to turn the screen lock
back on. Extending = writing a later time; nothing is restarted.

No-password mode (opt in with `lfg setup`): the password is typed one last time to add one rule,
/etc/sudoers.d/lfg-<your user id>, that lets this account run exactly `pmset -a disablesleep 1` and
`pmset -a disablesleep 0` as admin with no password. Then start, stop and extend never ask, and lfg never
touches the screen lock. One loop, run as you, keeps the Mac awake (the display can still sleep and lock)
and turns lid sleep back on at the end through that rule. `lfg setup --undo` and `lfg uninstall` take it out.
https://github.com/udayanwalvekar/lfg
"""
import datetime, fcntl, getpass, os, pwd, re, select, shutil, signal, stat, subprocess, sys, tempfile, termios, time, tty

VERSION = '1.1.0'
REPO = 'udayanwalvekar/lfg'
LATEST = 'https://raw.githubusercontent.com/%s/main/lfg.sh' % REPO

HOME = os.path.expanduser('~')
STATE = os.path.join(HOME, '.lfg')
SHARE = os.path.join(HOME, '.local', 'share', 'lfg')  # where the installer puts the program
DEADLINE = os.path.join(STATE, 'until')
STARTED = os.path.join(STATE, 'started')  # when the current run began (kept across extends)
LOCK_BEFORE = os.path.join(STATE, 'lock-before')  # the screen lock as it was before lfg: immediate, seconds, off
LOG = os.path.join(STATE, 'log')
ASKED = os.path.join(STATE, 'setup-asked')  # the first-run question was answered (yes or no): never asked again
SUDO, PMSET, SYSADMINCTL, ID = '/usr/bin/sudo', '/usr/bin/pmset', '/usr/sbin/sysadminctl', '/usr/bin/id'
CAFFEINATE, OSASCRIPT, PS, SH = '/usr/bin/caffeinate', '/usr/bin/osascript', '/bin/ps', '/bin/sh'
CURL, NOTHING = '/usr/bin/curl', '/usr/bin/true'
SUDOERS_D, VISUDO, CHOWN = '/etc/sudoers.d', '/usr/sbin/visudo', '/usr/sbin/chown'  # only for `lfg setup`
ROOT = 'root'  # the user the admin loop runs as
TICK = 20  # seconds between the loops' looks at the end time
DEFAULT_HOURS = 3
MAX_HOURS = 72  # an end further away than this is refused here and ignored by the loops (a typo, not a wish)
TRIES = 3

# The two loops, each ONE line (ps prints a command on one line; a newline inside would break reading it back).
# Args: $1 end-time file, $2 seconds between looks, $3 the end time at start, $4 program, $5 furthest end allowed.
# A file that is missing, not a plain file (a pipe, a link), half-written or not a plain time keeps the last
# good end: the run never stops early because of a bad read, and never runs on forever either. 0 = stop now.
_READ = ('e=; if [ -f "$f" ] && [ ! -L "$f" ]; then e=$(/usr/bin/head -c 12 "$f" 2>/dev/null); fi; '
         'now=$(/bin/date +%s); '
         'case $e in ""|*[!0-9]*|???????????*) e=$good;; esac; '
         '[ "$e" -gt $((now + cap)) ] && e=$good; good=$e; [ "$now" -ge "$e" ] && break; ')
# As admin: lid sleep comes back once the end has passed.
ROOT_LOOP = ('f=$1; tick=$2; good=$3; pmset=$4; cap=$5; '
             'while :; do ' + _READ + '/bin/sleep "$tick"; done; "$pmset" -a disablesleep 0')
# As him: keep the Mac awake (caffeinate ends by itself if this loop is killed), and at a natural end open a
# Terminal window for the password that puts the screen lock back as it was. Turned off by hand (0) = no window.
# Screen lock off before lfg = $6 is a program that does nothing, so no window.
USER_LOOP = ('f=$1; tick=$2; good=$3; caff=$4; cap=$5; osa=$6; c=; '
             'while :; do ' + _READ +
             'if [ -z "$c" ] || ! kill -0 "$c" 2>/dev/null; then "$caff" -dimsu -t 259200 -w $$ & c=$!; fi; '
             '/bin/sleep "$tick"; done; '
             '[ -n "$c" ] && kill "$c" 2>/dev/null; '
             '[ "$e" -ne 0 ] && "$osa" -e "$7" -e "$8"')
# No-password mode: ONE loop, as him. It keeps the Mac awake without keeping the display on (no -d, no -u), so
# the screen still dims and locks as he has it set, and at the end it turns lid sleep back on through the rule
# `lfg setup` added. Args: $1-$5 as above, $6 sudo, $7 pmset, $8 the log (a failed end is written there).
SOLO_LOOP = ('f=$1; tick=$2; good=$3; caff=$4; cap=$5; sudo=$6; pmset=$7; log=$8; c=; '
             'while :; do ' + _READ +
             'if [ -z "$c" ] || ! kill -0 "$c" 2>/dev/null; then "$caff" -ims -t 259200 -w $$ & c=$!; fi; '
             '/bin/sleep "$tick"; done; '
             '[ -n "$c" ] && kill "$c" 2>/dev/null; '
             '"$sudo" -n "$pmset" -a disablesleep 0 </dev/null >/dev/null 2>&1 || '
             '/bin/echo "$(/bin/date "+%Y-%m-%d %H:%M:%S")  end: lid sleep NOT back on, the rule said no" >> "$log"')
# As admin, once, at `lfg setup`: write the rule under a name sudo never reads (it skips names with a dot), make
# it root's and read-only, have visudo check it, and only then move it into place; then visudo checks the whole
# sudo setup with it, and takes it out again if that fails. Nothing reads stdin (the password is in it).
# Args: $1 the rule's path, $2 $3 its two lines, $4 visudo, $5 chown. Exit 3 = visudo refused the rule,
# 4 = visudo refused the whole setup with it in (taken out again), 5 = it could not be written.
ADD_RULE = ('exec </dev/null; umask 077; r=$1; t="$1.new"; /bin/rm -f "$t" || exit 5; '
            '/usr/bin/printf "%s\\n%s\\n" "$2" "$3" > "$t" || { /bin/rm -f "$t"; exit 5; }; '
            '{ "$5" 0:0 "$t" && /bin/chmod 0440 "$t"; } || { /bin/rm -f "$t"; exit 5; }; '
            '"$4" -c -q -f "$t" >/dev/null 2>&1 || { /bin/rm -f "$t"; exit 3; }; '
            '/bin/mv -f "$t" "$r" || { /bin/rm -f "$t"; exit 5; }; '
            '"$4" -c -q >/dev/null 2>&1 || { /bin/rm -f "$r"; exit 4; }')
DEL_RULE = 'exec </dev/null; /bin/rm -f "$1" "$1.new" && [ ! -e "$1" ]'


def relock(value):
    """The Terminal window's script at a natural end: the screen lock back to `value` (immediate or seconds,
    already checked to be one of those)."""
    return ('tell application "Terminal" to do script "echo; echo \'  lfg is over. Type your Mac password to turn '
            'the screen lock back on.\'; sysadminctl -screenLock %s -password -"' % value)

# ---- looks (same colours as ccd / ccdm) ------------------------------------------------------------------
TEAL, SKY, AMBER = (45, 212, 191), (56, 189, 248), (251, 191, 36)
STOPS = [(45, 212, 191), (56, 189, 248), (167, 139, 250), (244, 114, 182), (251, 113, 133)]
TRACK = (43, 45, 58)
EIGHTHS = ['', '▏', '▎', '▍', '▌', '▋', '▊', '▉']
TRUECOLOR = os.environ.get('COLORTERM') in ('truecolor', '24bit')


def colour(c, back=False):
    kind = 48 if back else 38
    if TRUECOLOR:
        return '%d;2;%d;%d;%d' % ((kind,) + tuple(c))
    if max(c) - min(c) < 24:  # a grey: the 24-step grey ramp is closer than the colour cube
        return '%d;5;%d' % (kind, 232 + min(23, max(0, round((sum(c) / 3 - 8) / 10))))
    return '%d;5;%d' % (kind, 16 + 36 * round(c[0] / 51) + 6 * round(c[1] / 51) + round(c[2] / 51))


def heat(t):
    x = min(max(t, 0), 1) * (len(STOPS) - 1)
    i = min(int(x), len(STOPS) - 2)
    return tuple(round(a + (b - a) * (x - i)) for a, b in zip(STOPS[i], STOPS[i + 1]))


def bar(done, width):
    """How much of the run has gone, as (text, style) pieces: gradient fill, a fractional tip, the track
    (the same bar as ccdm's usage bars)."""
    cells = min(max(done, 0), 1) * width
    full = int(cells)
    part = EIGHTHS[int((cells - full) * 8)]
    out = []
    for i in range(full):
        c = colour(heat(int(i / width * 24) / 23))
        if out and out[-1][1] == c:
            out[-1] = (out[-1][0] + '█', c)
        else:
            out.append(('█', c))
    if part:
        out.append((part, colour(heat(max(done, 0.01))) + ';' + colour(TRACK, back=True)))
    out.append(('█' * (width - full - (1 if part else 0)), colour(TRACK)))
    return out


def line(pieces, out=None):
    """Print (text, style) pieces as one line. In a terminal: coloured and cut at the window edge (never
    wraps). Anywhere else (an agent, a pipe): plain text, whole."""
    out = out or sys.stdout
    if out.isatty():
        try:
            cols = os.get_terminal_size(out.fileno()).columns
        except OSError:
            cols = 80
        print(paint(pieces, cols), file=out, flush=True)
    else:
        print(''.join(t for t, _ in pieces), file=out, flush=True)


def say(mark, text, note='', style=None, out=None):
    """One line of output: a coloured mark, the words, an optional dim note."""
    line([('  %s  ' % mark, (style or colour(TEAL)) + ';1'), (text, '')] + ([('  ·  ' + note, '2')] if note else []), out)


def aside(text, out=None):
    """A dim second line under the one above."""
    line([('     ' + text, '2')], out)


def clock(epoch, now=None):
    """'00:30', '12:14 tomorrow', '12:14 Tue'."""
    now = now or time.time()
    t, today = datetime.datetime.fromtimestamp(epoch), datetime.datetime.fromtimestamp(now).date()
    days = (t.date() - today).days
    return t.strftime('%H:%M') + ('' if days <= 0 else ' tomorrow' if days == 1 else t.strftime(' %a'))


def span(secs):
    m = max(0, round(secs / 60))
    h, m = divmod(m, 60)
    return '%dh %02dm' % (h, m) if h else '%dm' % m


def since(epoch, now=None):
    """'21:14' today, '21:14 yesterday', '21:14 Sat'."""
    now = now or time.time()
    t, today = datetime.datetime.fromtimestamp(epoch), datetime.datetime.fromtimestamp(now).date()
    days = (today - t.date()).days
    return t.strftime('%H:%M') + ('' if days <= 0 else ' yesterday' if days == 1 else t.strftime(' %a'))


def hours_words(h):
    return ('%g hour' % h) + ('' if h == 1 else 's')


# ---- what is running -------------------------------------------------------------------------------------
def log(text):
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(LOG, 'a') as f:
            f.write('%s  %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), text))
    except OSError:
        pass


def run(args, pw=None, **kw):
    """Run a program; the password, if any, goes in on stdin only (never on a command line)."""
    try:
        return subprocess.run(args, input=(pw + '\n') if pw is not None else None, text=True,
                              capture_output=True, timeout=kw.pop('timeout', 30), **kw)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 99, '', str(e))


def seconds(etime):
    """ps elapsed time [[dd-]hh:]mm:ss -> seconds."""
    days, _, rest = etime.rpartition('-')
    parts = [int(p) for p in rest.split(':')]
    while len(parts) < 3:
        parts.insert(0, 0)
    return (int(days) if days else 0) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def processes():
    out = []
    for line in run([PS, '-axww', '-o', 'pid=,ppid=,user=,etime=,command=']).stdout.splitlines():
        bits = line.split(None, 4)
        if len(bits) == 5 and bits[0].isdigit():
            try:
                out.append(dict(pid=int(bits[0]), ppid=int(bits[1]), user=bits[2], age=seconds(bits[3]), cmd=bits[4]))
            except ValueError:
                continue
    return out


def read_time(path):
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return None
        with open(path) as f:
            text = f.read(12).strip()
    except OSError:
        return None
    return int(text) if text.isdigit() and len(text) <= 10 else None


def write_text(path, text):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix='.time-')
    with os.fdopen(fd, 'w') as f:
        f.write(text + '\n')
    os.replace(tmp, path)  # all at once: a loop never reads half a number


def write_time(path, epoch):
    write_text(path, '%d' % epoch)


def read_end():
    return read_time(DEADLINE)


def write_end(epoch):
    write_time(DEADLINE, epoch)


def sleep_disabled():
    m = re.search(r'SleepDisabled\s+(\d)', run([PMSET, '-g']).stdout)
    return bool(m and m.group(1) == '1')


def lock_setting():
    """The screen lock now: 'off', 'immediate', a number of seconds (as text), or None if macOS didn't say."""
    r = run([SYSADMINCTL, '-screenLock', 'status'])
    text = r.stdout + r.stderr
    if 'screenLock is off' in text:
        return 'off'
    m = re.search(r'screenLock delay is (immediate|\d{1,6})\b', text)
    return m.group(1) if m else None


def lock_off():
    return lock_setting() == 'off'


def read_lock_before():
    try:
        if not stat.S_ISREG(os.lstat(LOCK_BEFORE).st_mode):
            return None
        with open(LOCK_BEFORE) as f:
            v = f.read(12).strip()
    except OSError:
        return None
    return v if v in ('off', 'immediate') or (v.isdigit() and len(v) <= 6) else None


def remember_lock(now):
    """Before a run turns the screen lock off: keep how it was, to put it back exactly so. A lock that is off
    only because an earlier run's lock window was ignored keeps the setting saved back then."""
    if now is None or (now == 'off' and read_lock_before() is not None):
        return
    write_text(LOCK_BEFORE, now)


def rule_path():
    """Where `lfg setup` puts the no-password rule: one file per account, named by its user id. No dot in the
    name: sudo skips files in sudoers.d whose names have one (so the half-made lfg-501.new is never read)."""
    return os.path.join(SUDOERS_D, 'lfg-%d' % os.getuid())


def free_mode():
    """No-password mode is on when the rule is there. Only an admin can put a file in that folder."""
    return os.path.exists(rule_path())


def status():
    """Everything lfg needs to know, read from the Mac itself (live processes + the lid-sleep setting)."""
    now, me = time.time(), pwd.getpwuid(os.getuid()).pw_name
    procs = processes()
    free = free_mode()
    mine = lambda p, name: p['cmd'].startswith(SH + ' -c ') and (' %s %s ' % (name, DEADLINE)) in p['cmd']
    s = dict(now=now, admin=[p for p in procs if p['user'] == ROOT and mine(p, 'lfg-root')],
             awake=[p for p in procs if p['user'] == me and mine(p, 'lfg-user')],
             sleep_off=sleep_disabled(),
             # No-password mode never touches the screen lock, so it doesn't even read it.
             lock=None if free else lock_setting(), lock_was=None if free else read_lock_before(), end=read_end())
    s['free'] = free
    s['solo'] = [p for p in procs if p['user'] == me and mine(p, 'lfg-solo')]  # no-password mode's one loop
    s['lock_off'] = s['lock'] == 'off'
    # Off because of lfg (it was on before a run), not because that is how he keeps it.
    s['lock_left_off'] = s['lock_off'] and s['lock_was'] not in (None, 'off')
    s['started'] = None
    keepers = s['admin'] + s['solo']  # whatever will turn lid sleep back on at the end
    if keepers and s['end'] and s['end'] > now:
        s['kind'], s['until'] = 'on', s['end']
        first = read_time(STARTED)
        loop = now - max(p['age'] for p in keepers)
        s['started'] = first if first and first <= now else loop
    elif s['sleep_off']:
        s['kind'], s['until'] = 'stuck', None
    else:
        s['kind'], s['until'] = 'off', None
    return s


def describe(s, out=None):
    if s['kind'] == 'on':
        left = s['until'] - s['now']
        say('✦', 'lfg is on until ' + clock(s['until'], s['now']), span(left) + ' left', out=out)
        aside('Started %s, %s ago' % (since(s['started'], s['now']), span(s['now'] - s['started'])), out)
        if not s['sleep_off']:
            aside('But lid sleep is back ON: something else changed it. lfg 0, then lfg, sets it right.', out)
    elif s['kind'] == 'stuck':
        say('!', 'Lid sleep is off and nothing will turn it back on', style=colour(AMBER), out=out)
        aside('Left over from an earlier run, or set by something else. lfg starts a fresh run; lfg off puts it back.', out)
    else:
        say('·', 'lfg is off', 'lfg = 3 hours, lfg 6 = 6 hours', style='2', out=out)
    if s['kind'] in ('off', 'stuck') and s['lock_left_off']:
        say('!', 'The screen lock is still off', 'lfg off turns it back on', style=colour(AMBER), out=out)
    if s['free']:
        aside('No password needed to start, stop or extend it.', out)


# ---- the password, once ----------------------------------------------------------------------------------
class NoTerminal(Exception):
    pass


def ask(prompt):
    """Read the password from the terminal itself, never from piped input. getpass puts echo back even on
    Ctrl-C."""
    try:
        os.close(os.open('/dev/tty', os.O_RDWR))
    except OSError:
        raise NoTerminal
    return getpass.getpass(prompt)


def is_admin():
    """In the admin group (out of the box, only admins can use sudo). If id can't tell, assume so."""
    r = run([ID, '-Gn'])
    return r.returncode != 0 or 'admin' in r.stdout.split()


def password(why, more=''):
    """His Mac password, checked with sudo before anything changes. None if he gave up."""
    say('✦', why)
    if more:
        aside(more)
    for left in range(TRIES, 0, -1):
        pw = ask('     Mac password: ')
        if run([SUDO, '-S', '-p', '', '-k', '-v'], pw).returncode == 0:
            # -k first: the check really checks this password, not a sudo still remembered from earlier
            log('password ok')
            return pw
        log('password refused')
        if not is_admin():  # no password would do: say why instead of asking again
            say('!', 'lfg needs an admin account on this Mac', 'yours is a standard account · nothing changed',
                style=colour(AMBER))
            aside('Keeping the Mac awake with the lid shut is a setting only an admin can change.')
            return None
        if left > 1:
            say('!', "That password didn't work", '%d more %s' % (left - 1, 'try' if left == 2 else 'tries'),
                style=colour(AMBER))
    say('!', 'Password not accepted', 'nothing changed', style=colour(AMBER))
    return None


# ---- doing it --------------------------------------------------------------------------------------------
class Busy:
    """Ctrl-C waits while the Mac's settings are being changed, so a run is never left half made."""

    def __enter__(self):
        self.old = signal.signal(signal.SIGINT, signal.SIG_IGN)

    def __exit__(self, *exc):
        signal.signal(signal.SIGINT, self.old)


def wait_for(test, secs=5):
    stop = time.time() + secs
    while time.time() < stop:
        s = status()
        if test(s):
            return s
        time.sleep(0.25)
    return status()


def screen_lock(pw, want):
    """Screen lock to `want` (off, immediate or seconds), with the password on stdin. Judged by reading it back;
    if the piped password was not taken, sysadminctl asks in the terminal itself."""
    done = (lambda: lock_off()) if want == 'off' else (lambda: not lock_off())
    if done():
        return True
    r = run([SYSADMINCTL, '-screenLock', want, '-password', '-'], pw)
    log('screen lock %s: exit %d' % (want, r.returncode))
    if done():
        return True
    say('!', 'The screen lock needs your password once more', 'macOS did not take it the first time',
        style=colour(AMBER))
    try:
        subprocess.run([SYSADMINCTL, '-screenLock', want, '-password', '-'], stdin=open('/dev/tty'), timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return done()


def start(end, pw):
    """Make lfg run until `end`. Reads the Mac afresh: what was on screen before the password may be stale.
    The admin loop comes first, so lid sleep is only switched off once something will switch it back on.
    Returns the status afterwards; the caller reports from that, never from what it hoped."""
    s = status()
    if (s['admin'] or s['awake']) and s['kind'] != 'on':
        # Loops whose end has passed (or that were told to stop) are about to finish and put sleep back.
        # Let them go first, so their "sleep back on" cannot land after this run's "sleep off".
        s = wait_for(lambda x: not x['admin'] and not x['awake'], TICK + 10)
    write_end(end)
    log('end set to %s' % clock(end))
    # When this run began: carried over from a run already going, else now.
    write_time(STARTED, int(s['started'] if s['kind'] == 'on' and s['started'] else time.time()))
    remember_lock(s['lock'])
    was = read_lock_before() or 'immediate'
    if not s['admin']:
        subprocess.run([SUDO, '-S', '-p', '', '-b', SH, '-c', ROOT_LOOP, 'lfg-root', DEADLINE, str(TICK), str(end),
                        PMSET, str(MAX_HOURS * 3600)], input=pw + '\n', text=True, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, start_new_session=True, timeout=30)
        if not wait_for(lambda x: x['admin'])['admin']:
            log('admin loop did not start: nothing else changed')
            return status()
    r = run([SUDO, '-S', '-p', '', PMSET, '-a', 'disablesleep', '1'], pw)
    log('lid sleep off: exit %d' % r.returncode)
    if not s['awake']:
        subprocess.Popen([SH, '-c', USER_LOOP, 'lfg-user', DEADLINE, str(TICK), str(end), CAFFEINATE,
                          str(MAX_HOURS * 3600), NOTHING if was == 'off' else OSASCRIPT,
                          'tell application "Terminal" to activate', relock(was)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    screen_lock(pw, 'off')
    new = wait_for(lambda x: x['admin'] and x['awake'] and x['sleep_off'])
    log('loops: admin %s, awake %s, lid sleep off %s, screen lock off %s'
        % (bool(new['admin']), bool(new['awake']), new['sleep_off'], new['lock_off']))
    return new


def turn_off(pw):
    write_end(0)  # the loops see 0 at their next look and end quietly (no lock window)
    r = run([SUDO, '-S', '-p', '', PMSET, '-a', 'disablesleep', '0'], pw)
    log('off: lid sleep back on, exit %d' % r.returncode)
    was = read_lock_before() or 'immediate'  # no record: on is the safe side
    if was != 'off':
        screen_lock(pw, was)
    return status()


# ---- no-password mode (after `lfg setup`) ----------------------------------------------------------------
def no_password(*args):
    """Run pmset as admin through the rule: sudo -n never asks, it only says yes or no."""
    return run([SUDO, '-n', PMSET] + list(args), stdin=subprocess.DEVNULL)


def start_free(end):
    """The same run with no password and no screen lock. The loop that turns lid sleep back on comes first, then
    lid sleep goes off through the rule. Returns the status afterwards ('refused' set if the rule said no)."""
    s = status()
    if (s['admin'] or s['awake'] or s['solo']) and s['kind'] != 'on':
        s = wait_for(lambda x: not x['admin'] and not x['awake'] and not x['solo'], TICK + 10)  # as in start()
    write_end(end)
    log('end set to %s (no password)' % clock(end))
    write_time(STARTED, int(s['started'] if s['kind'] == 'on' and s['started'] else time.time()))
    if not s['solo'] and not s['admin']:
        subprocess.Popen([SH, '-c', SOLO_LOOP, 'lfg-solo', DEADLINE, str(TICK), str(end), CAFFEINATE,
                          str(MAX_HOURS * 3600), SUDO, PMSET, LOG],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        if not wait_for(lambda x: x['solo'])['solo']:
            log('keep-awake loop did not start: nothing else changed')
            return status()
    r = no_password('-a', 'disablesleep', '1')
    log('lid sleep off (no password): exit %d' % r.returncode)
    if r.returncode:
        write_end(0)  # lid sleep was never turned off: nothing for the loop to put back
        log('the no-password rule said no: run stopped')
        new = end_solo()
        new['refused'] = True
        return new
    new = wait_for(lambda x: (x['solo'] or x['admin']) and x['sleep_off'])
    log('loops: keep-awake %s, lid sleep off %s' % (bool(new['solo'] or new['admin']), new['sleep_off']))
    return new


def end_solo():
    """Stop no-password mode's loop now instead of at its next look (up to 20 s away), so lfg setup --undo or
    lfg uninstall can follow straight after. Found afresh by its command line, so a reused number is never hit."""
    for p in status()['solo']:
        try:
            os.kill(p['pid'], signal.SIGTERM)  # its caffeinate ends with it (-w)
        except OSError:
            pass
    return wait_for(lambda x: not x['solo'], 3)


def turn_off_free():
    write_end(0)  # the loop sees 0 at its next look and ends
    r = no_password('-a', 'disablesleep', '0')
    log('off (no password): lid sleep back on, exit %d' % r.returncode)
    return end_solo() if r.returncode == 0 else status()


# ---- the choice when it is already on ----------------------------------------------------------------
def choices(s):
    base = s['until']
    return [('add', 3, 'Add 3 hours', 'until ' + clock(base + 3 * 3600, s['now'])),
            ('add', 6, 'Add 6 hours', 'until ' + clock(base + 6 * 3600, s['now'])),
            ('custom', None, 'Custom…', 'type how many hours to add'),
            ('off', 0, 'Turn it off now', 'the Mac can sleep again · no password' if s.get('free') else
             'sleep and screen lock come back · asks your password'),
            ('leave', 0, 'Leave it as it is', '')]


def press(n, at, key):
    """One key in the list -> (highlighted row, 'go' | 'quit' | None)."""
    if key in ('up', 'k', 'down', 'j'):
        return (at + (-1 if key in ('up', 'k') else 1)) % n, None
    if key == 'enter':
        return at, 'go'
    if key in ('esc', 'q'):
        return at, 'quit'
    if len(key) == 1 and key.isdigit() and 1 <= int(key) <= n:
        return int(key) - 1, 'go'
    return at, None


def custom_hours(s, typed):
    """What he has typed into Custom -> (hours or None, problem or '')."""
    if not typed:
        return None, ''
    try:
        h = float(typed)
    except ValueError:
        return None, 'a number of hours, e.g. 2 or 1.5'
    room = (s['now'] + MAX_HOURS * 3600 - s['until']) / 3600
    if not 0 < h:
        return None, 'more than 0'
    if h > room:
        return None, 'at most %g more (lfg runs up to %d hours ahead)' % (int(room * 10) / 10, MAX_HOURS)
    return h, ''


def type_key(typed, key):
    """One key while typing into Custom -> (typed, 'go' | 'back' | None)."""
    if key == 'enter':
        return typed, 'go'
    if key in ('esc', 'up', 'down'):
        return typed, 'back'
    if key in ('\x7f', '\x08'):
        return typed[:-1], None
    if len(key) == 1 and (key.isdigit() or key == '.') and len(typed) < 5:
        return typed + key, None
    return typed, None


def head(s, cols):
    """The top of the list: where the run stands."""
    teal = colour(TEAL)
    left, gone = s['until'] - s['now'], s['now'] - s['started']
    width = max(10, min(40, cols - 18))
    rows = [[], [('  ✦  ', teal), ('lfg is on', '1')], [],
            [('     Started  ', '2'), ('%-16s' % since(s['started'], s['now']), ''), (span(gone) + ' ago', '2')],
            [('     Ends     ', '2'), ('%-16s' % clock(s['until'], s['now']), ''), (span(left) + ' left', teal + ';1')],
            [('     ', '')] + bar(gone / max(left + gone, 1), width)
            + [('  %d%% done' % round(100 * gone / max(left + gone, 1)), '2')]]
    return rows


def frame(s, rows, at, cols, typing=None):
    teal = colour(TEAL)
    out = head(s, cols) + [[]]
    for i, (kind, _, label, note) in enumerate(rows):
        on = i == at
        lead = [('  ❯ ' if on else '    ', teal + ';1'), ('%d  ' % (i + 1), teal if on else '2')]
        if kind == 'custom' and on and typing is not None:
            h, problem = custom_hours(s, typing)
            box = ' %s▏' % typing
            entry = [('Add', '1'), (box, teal + ';1'), (' hours'.ljust(18 - 3 - len(box)), '1')]  # 18 = label column
            tail = (problem, colour(AMBER)) if problem else \
                ('until ' + clock(s['until'] + h * 3600, s['now']), '2') if h else ('type a number, e.g. 2 or 1.5', '2')
            out.append(lead + entry + [tail])
            continue
        out.append(lead + [('%-18s' % label, '1' if on else ''), (note, '2')])
    hint = '  Type the hours  ·  Enter add  ·  Esc back' if typing is not None else \
        '  ↑ ↓ move  ·  Enter choose  ·  or press its number  ·  Esc leave it'
    out += [[], [(hint, '2')]]
    return out


def question_frame(title, notes, rows, at, hint):
    """One question on its own screen, Claude Code's way: the question in bold, plain notes under it, numbered
    choices, the keys right under them."""
    teal = colour(TEAL)
    out = [[], [('  ✦  ', teal + ';1'), (title, '1')]]
    out += [[('     ' + n, '2')] if n else [] for n in notes]
    out.append([])
    for i, (label, note) in enumerate(rows):
        on = i == at
        out.append([('  ❯ ' if on else '    ', teal + ';1'), ('%d  ' % (i + 1), teal if on else '2'),
                    ('%-24s' % label, '1' if on else ''), (note, '2')])
    return out + [[], [(hint, '2')]]


def paint(pieces, cols):
    left, out = cols - 1, ''
    for text, style in pieces:
        text = text[:max(left, 0)]
        left -= len(text)
        if text:
            out += '\x1b[%sm%s\x1b[0m' % (style, text) if style and not os.environ.get('NO_COLOR') else text
    return out


class Menu:
    """The choice, drawn on the terminal itself (/dev/tty) on its spare screen, so the shell looks untouched
    afterwards. Raises OSError / termios.error when there is no terminal."""

    def __init__(self):
        self.fd = os.open('/dev/tty', os.O_RDWR)
        self.old = termios.tcgetattr(self.fd)
        try:
            tty.setcbreak(self.fd)
            mode = termios.tcgetattr(self.fd)
            off = bytes([os.fpathconf(self.fd, 'PC_VDISABLE')])
            for k in ('VSUSP', 'VDSUSP', 'VQUIT'):  # Ctrl-Z / Ctrl-\ would leave this screen stuck up
                if hasattr(termios, k):
                    mode[6][getattr(termios, k)] = off
            termios.tcsetattr(self.fd, termios.TCSANOW, mode)
            os.write(self.fd, b'\x1b[?1049h\x1b[?25l')
        except BaseException:
            self.close()
            raise

    def close(self):
        if self.fd is None:
            return
        os.write(self.fd, b'\x1b[?25h\x1b[?1049l')
        termios.tcsetattr(self.fd, termios.TCSAFLUSH, self.old)
        os.close(self.fd)
        self.fd = None

    def key(self):
        b = os.read(self.fd, 1)
        if b in (b'\r', b'\n'):
            return 'enter'
        if b in (b'', b'\x04', b'\x03'):
            return 'esc'
        if b != b'\x1b':
            return b.decode('latin-1')
        seq = b''  # an arrow is Esc + more bytes at once; read the whole code so its digits are not row numbers
        while select.select([self.fd], [], [], 0.05)[0]:
            seq += os.read(self.fd, 1)
            if len(seq) > 1 and 0x40 <= seq[-1] <= 0x7e:
                break
        if not seq:
            return 'esc'
        return {b'A': 'up', b'B': 'down'}.get(seq[-1:], '') if seq[:1] in (b'[', b'O') else ''

    def choose(self, s, rows):
        termios.tcflush(self.fd, termios.TCIFLUSH)  # keys typed before the list showed are dropped
        at, typing = 0, None  # typing: what he has typed into Custom, or None while moving in the list
        while True:
            cols = os.get_terminal_size(self.fd).columns
            lines = frame(s, rows, at, cols, typing)
            os.write(self.fd, ('\x1b[H\x1b[J' + '\r\n'.join(paint(l, cols) for l in lines)).encode())
            key = self.key()
            if typing is not None:
                typing, act = type_key(typing, key)
                if act == 'back':
                    typing = None
                elif act == 'go':
                    h = custom_hours(s, typing)[0]
                    if h:
                        return ('add', h, 'Add %g hours' % h, '')
                continue
            at, act = press(len(rows), at, key)
            if act == 'go' and rows[at][0] == 'custom':
                typing = ''
            elif act:
                return rows[at] if act == 'go' else None

    def question(self, title, notes, rows, hint):
        """-> the row picked (0, 1, …), or None for Esc."""
        termios.tcflush(self.fd, termios.TCIFLUSH)  # keys typed before the question showed are dropped
        at = 0
        while True:
            cols = os.get_terminal_size(self.fd).columns
            lines = question_frame(title, notes, rows, at, hint)
            os.write(self.fd, ('\x1b[H\x1b[J' + '\r\n'.join(paint(l, cols) for l in lines)).encode())
            at, act = press(len(rows), at, self.key())
            if act:
                return at if act == 'go' else None


def pick(s):
    try:
        menu = Menu()
    except (OSError, termios.error):
        return None
    try:
        return menu.choose(s, choices(s))
    finally:
        menu.close()


# ---- lfg setup: the password one last time, then never --------------------------------------------------
SETUP_TITLE = 'Never ask for your password again?'
SETUP_NOTES = ['Type it one last time and lfg adds one rule to this Mac.',
               '',
               'The rule lets your account turn lid sleep off and on with no password.',
               "That's all it allows. Any program on this Mac could then keep it awake.",
               'Nothing more.',
               '',
               'lfg also stops turning off your screen lock. The Mac keeps working with',
               'the lid shut, and locks like it normally does.']
SETUP_ROWS = [('Yes, never ask again', 'asks your password one last time'),
              ('No, keep asking', 'lfg works like it does now')]
SETUP_HINT = '  ↑ ↓ move  ·  Enter choose  ·  or press its number  ·  Esc not now'


def can_ask():
    """Someone is at a terminal to answer: lfg's own output goes to one, and the terminal opens."""
    try:
        if not sys.stdout.isatty():
            return False
        os.close(os.open('/dev/tty', os.O_RDWR))
        return True
    except (OSError, ValueError):
        return False


def setup_question():
    """The one question, on its own screen. -> True (yes), False (no or Esc). Raises NoTerminal."""
    try:
        menu = Menu()
    except (OSError, termios.error):
        raise NoTerminal
    try:
        at = menu.question(SETUP_TITLE, SETUP_NOTES, SETUP_ROWS, SETUP_HINT)
    finally:
        menu.close()
    write_text(ASKED, '%s %s' % ('yes' if at == 0 else 'no', time.strftime('%Y-%m-%d')))
    return at == 0


def rule_lines():
    """The rule's two lines: what it is, and the rule. The account by name when it is a plain lowercase name,
    else by user id (#501), which needs no escaping (an all-capitals name would read to sudo as an alias)."""
    name = pwd.getpwuid(os.getuid()).pw_name
    who = name if re.fullmatch(r'[a-z_][a-z0-9_.-]{0,63}', name) else '#%d' % os.getuid()
    return ('# lfg (github.com/%s) lets %s turn lid sleep off and on with no password. '
            'Nothing else. Take it out with: lfg setup --undo' % (REPO, who),
            '%s ALL = (root) NOPASSWD: %s -a disablesleep 1, %s -a disablesleep 0' % (who, PMSET, PMSET))


STILL_IN = "It's in, but doesn't work, and couldn't be taken out: lfg setup --undo"


def add_rule(pw):
    """Put the rule in. -> '' when it is in and works, else why not (and then it is not there). It goes in only
    if visudo passes it, and stays only if sudo then really runs lfg's command without a password."""
    path = rule_path()
    first, second = rule_lines()
    r = run([SUDO, '-S', '-p', '', SH, '-c', ADD_RULE, 'lfg-setup', path, first, second, VISUDO, CHOWN], pw)
    log('setup: add the rule: exit %d' % r.returncode)
    if r.returncode == 3:
        return "visudo didn't accept it."
    if r.returncode == 4:
        return "With it in, this Mac's sudo settings didn't pass visudo's check."
    if r.returncode:
        return "It couldn't be written."
    if not os.path.exists(path):  # written, but this account can't see that folder: lfg would never know it's there
        why = "lfg can't see into %s, so it was taken out again." % SUDOERS_D
    else:
        run([SUDO, '-k'], stdin=subprocess.DEVNULL)  # forget the password sudo just took: the try is the rule alone
        t = no_password('-a', 'disablesleep', '0')  # lfg's own command; lid sleep is already on, so it changes nothing
        log('setup: the rule, tried with no password: exit %d' % t.returncode)
        if t.returncode == 0:
            return ''
        why = "This Mac's sudo doesn't use it, so it was taken out again."  # not read, or a later rule wins
    if not drop_rule(pw):
        return STILL_IN
    return why


def make_free():
    """Yes to the question: the password one last time, the rule in, tried. -> True if it is on."""
    pw = password('Type your Mac password one last time', 'lfg adds the rule with it. The password is not kept.')
    if pw is None:
        return False
    with Busy():
        why = add_rule(pw)
    del pw
    if why:
        say('!', "Couldn't add the rule", 'it is still there' if why == STILL_IN else 'nothing changed',
            style=colour(AMBER))
        aside(why)
        return False
    try:
        os.remove(LOCK_BEFORE)  # the screen lock is no longer lfg's business
    except OSError:
        pass
    say('✓', "Done · lfg won't ask for your password again")
    aside('The rule allows only pmset -a disablesleep 1 and 0, as admin.')
    aside("It's in %s. lfg setup --undo takes it out." % rule_path())
    return True


def busy_now(s):
    """Why the password mode can't change right now, or ''. Loops whose end has passed are let finish first."""
    if s['kind'] != 'on' and (s['admin'] or s['awake'] or s['solo']):
        say('·', 'The last run is finishing', 'a few seconds', style='2')
        s.update(wait_for(lambda x: not x['admin'] and not x['awake'] and not x['solo'], TICK + 10))
    if s['kind'] == 'on' or s['admin'] or s['awake'] or s['solo']:
        return 'lfg is on right now'
    if s['kind'] == 'stuck':
        return 'Lid sleep is still off'
    if s['lock_left_off']:
        return 'The screen lock is still off from a run'
    return ''


def first_run(s):
    """At the first start typed in a terminal: the question, once. -> 'free' (the rule is in: start with no
    password), 'stop' (yes, but it didn't work: say so and stop) or 'usual' (no, or not asked)."""
    if s['free'] or os.path.lexists(ASKED) or not os.path.isdir(SUDOERS_D) or not can_ask() or busy_now(s):
        return 'usual'
    if not setup_question():
        say('·', 'lfg will keep asking for your password', 'lfg setup changes that', style='2')
        return 'usual'
    return 'free' if make_free() else 'stop'


def setup(args):
    """`lfg setup` asks the question; `lfg setup --undo` takes the rule out."""
    if args and args[0] in ('--undo', 'undo', '-u'):
        return unsetup()
    if args:
        say('!', 'lfg setup takes nothing, or --undo', 'e.g. lfg setup', style=colour(AMBER))
        return 2
    s = status()
    if s['free']:
        say('✓', "lfg already never asks for your password", 'lfg setup --undo asks again')
        return 0
    problem = busy_now(s)
    if problem:
        say('!', problem, 'lfg off, then lfg setup', style=colour(AMBER))
        return 1
    if not os.path.isdir(SUDOERS_D):
        say('!', "This Mac can't take the rule", 'it has no %s · nothing changed' % SUDOERS_D, style=colour(AMBER))
        return 1
    if not can_ask():
        say('!', 'lfg setup needs you at the Mac', 'run it in Terminal', style=colour(AMBER))
        return 1
    if not setup_question():
        say('·', 'Nothing changed', 'lfg keeps asking for your password', style='2')
        return 0
    return 0 if make_free() else 1


def drop_rule(pw):
    """Take the rule out. -> True if it is gone (by root's own look, as well as ours)."""
    r = run([SUDO, '-S', '-p', '', SH, '-c', DEL_RULE, 'lfg-unsetup', rule_path()], pw)
    log('rule taken out: exit %d' % r.returncode)
    return r.returncode == 0 and not os.path.exists(rule_path())


def unsetup():
    s = status()
    if not s['free']:
        say('·', 'lfg already asks for your password', 'nothing to undo', style='2')
        return 0
    if busy_now(s) == 'lfg is on right now':  # its loop needs the rule to turn lid sleep back on
        say('!', 'lfg is on right now', 'lfg off first, then lfg setup --undo', style=colour(AMBER))
        return 1
    stuck = s['sleep_off']
    pw = password('Take out the no-password rule · lfg will ask for your password again',
                  'Lid sleep is still off; this turns it back on too.' if stuck else '')
    if pw is None:
        return 1
    with Busy():
        gone = drop_rule(pw)
        if stuck:
            r = run([SUDO, '-S', '-p', '', PMSET, '-a', 'disablesleep', '0'], pw)
            log('lid sleep back on: exit %d' % r.returncode)
    del pw
    if not gone:
        say('!', "Couldn't take the rule out", 'see ~/.lfg/log', style=colour(AMBER))
        return 1
    say('✓', 'Done · lfg asks for your password again')
    aside('And it turns the screen lock off while it runs, as before.')
    if stuck and sleep_disabled():
        say('!', 'Lid sleep is still off', 'lfg off puts it back', style=colour(AMBER))
        return 1
    return 0


# ---- main ------------------------------------------------------------------------------------------------
def parse(args):
    """-> (what, hours). what: start | add | off | status | help | bad."""
    if not args:
        return 'start', None
    a = args[0].lower()
    if a in ('status', 's', '?'):
        return 'status', None
    if a in ('off', 'stop', '0'):
        return 'off', None
    if a in ('help', '-h', '--help'):
        return 'help', None
    if a in ('version', '--version', '-v'):
        return 'version', None
    if a in ('update', 'uninstall', 'installed', 'setup'):
        return a, None
    add = a.startswith('+')
    try:
        h = float(a[1:] if add else a)
    except ValueError:
        return 'bad', None
    if not 0 < h <= MAX_HOURS or h != h:
        return 'bad', h
    return ('add' if add else 'start'), h


def finish_on(s, verb):
    say('✓', '%s until %s' % (verb, clock(s['until'], s['now'])), span(s['until'] - s['now']) + ' left')
    aside('Lid shut is fine. Run lfg again to extend or turn it off.')
    if s['free']:
        aside('Your screen lock is left as you have it.')
    elif not s['lock_off']:
        say('!', 'The screen lock is still on', 'the Mac will lock when idle', style=colour(AMBER))


def report(new, verb, failed):
    """Say what is true now (read from the Mac), not what was meant to happen."""
    if new['kind'] == 'on' and new['sleep_off']:
        finish_on(new, verb)
        return 0
    say('!', failed, style=colour(AMBER))
    if new.get('refused'):
        aside("The no-password rule didn't work: run lfg setup --undo, then lfg setup.")
    describe(new)
    aside('What happened is in ~/.lfg/log')
    return 1


def extend(end):
    """Already running (new style): a later end time is all it takes. No password."""
    write_end(end)
    log('extended to %s' % clock(end))
    return report(status(), 'Extended', 'Could not extend')


def locked(fn):
    """One lfg at a time: a second window waits for nothing and says so."""
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    with open(os.path.join(STATE, 'lock'), 'w') as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say('!', 'lfg is busy in another window', 'try again in a moment', style=colour(AMBER))
            return 1
        return fn()


def main(args=None):
    args = sys.argv[1:] if args is None else args
    what, hours = parse(args)
    if what == 'help':
        print(__doc__.strip().split('\n\nYour Mac')[0])
        return 0
    if what == 'bad':
        say('!', 'lfg takes a number of hours (up to %d), +hours, off or status' % MAX_HOURS, 'e.g. lfg 6',
            style=colour(AMBER))
        return 2
    if what == 'status':
        describe(status())
        return 0
    if what == 'version':
        print('lfg ' + VERSION)
        return 0
    if what in ('update', 'uninstall', 'installed'):
        return {'update': update, 'uninstall': uninstall, 'installed': installed}[what](args[1:])
    try:
        if what == 'setup':
            return locked(lambda: setup(args[1:]))
        return locked(lambda: act(what, hours, status()))
    except NoTerminal:
        say('!', 'This needs your Mac password', 'run %s in Terminal' % (
            'lfg ' + ' '.join(args[:2]) if what == 'setup' else 'lfg'), style=colour(AMBER))
        return 1
    except KeyboardInterrupt:  # only possible at the password or the list: changes are made with Ctrl-C held
        print()
        say('·', 'Stopped', 'nothing changed', style='2')
        return 130


# ---- install, update, remove ----------------------------------------------------------------------------
def installed(args):
    """What the installer shows at the end of a first install."""
    say('✦', 'lfg %s is installed' % VERSION)
    aside('Type lfg to keep this Mac awake with the lid shut for 3 hours.')
    aside('lfg 6 = 6 hours · lfg status · lfg off · lfg help')
    return 0


def fetch(url):
    """The page's bytes, by the Mac's own curl (its certificates work even where this Python's don't)."""
    try:
        r = subprocess.run([CURL, '-fsSL', '--max-time', '30', url], capture_output=True, timeout=40)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise OSError(str(e))
    if r.returncode:
        raise OSError(r.stderr.decode('utf-8', 'replace').strip() or 'curl exit %d' % r.returncode)
    return r.stdout


def update(args):
    """`lfg update`: fetch the newest lfg.sh and run it over this one. A run that is on keeps going."""
    print('lfg: checking for a newer lfg…', file=sys.stderr)
    try:
        body = fetch(LATEST + '?v=%d' % time.time())
    except OSError as e:
        print("lfg update: couldn't reach GitHub (%s). Nothing changed." % e, file=sys.stderr)
        return 1
    found = re.search(rb"^VERSION = '([0-9.]+)'$", body, re.M)
    if not (body.startswith(b'#!/usr/bin/env bash') and b'LFG_PROGRAM_END' in body and found):
        print("lfg update: what came back doesn't look like lfg. Nothing changed.", file=sys.stderr)
        return 1
    new = found.group(1).decode()
    number = lambda v: tuple(int(x) for x in v.split('.') if x.isdigit())
    if number(new) <= number(VERSION) and '--force' not in args:
        print('lfg: you have the newest, %s' % VERSION)
        return 0
    fd, path = tempfile.mkstemp(suffix='.sh')
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(body)
        code = subprocess.run(['/bin/bash', path], env=dict(os.environ, LFG_QUIET='1'), stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL).returncode
    finally:
        os.unlink(path)
    if code:
        print('lfg update: the update did not finish. The lfg you had still works.', file=sys.stderr)
        return 1
    print('lfg: updated %s → %s' % (VERSION, new))
    return 0


def uninstall(args):
    """`lfg uninstall`: remove the program, its command and ~/.lfg. Refused while a run is on, so nothing is
    left with lid sleep off and no one to turn it back on."""
    s = status()
    if s['kind'] in ('on', 'stuck') or s['admin'] or s['awake'] or s['solo'] or s['lock_left_off']:
        why = 'lfg is on right now' if s['kind'] == 'on' or s['admin'] or s['awake'] or s['solo'] else \
            'Lid sleep is still off' if s['kind'] == 'stuck' else 'The screen lock is still off from a run'
        say('!', why, 'lfg off puts it right · then lfg uninstall', style=colour(AMBER))
        return 1
    if s['free']:  # the no-password rule goes first: if it can't go, nothing is removed
        def ask_and_drop():
            pw = password('Remove lfg · type your Mac password to take out its no-password rule')
            if pw is None:
                return 1
            with Busy():
                gone = drop_rule(pw)
            del pw
            if not gone:
                say('!', 'lfg is still installed', 'the rule is still there · nothing removed', style=colour(AMBER))
                return 1
            return 0
        try:
            code = locked(ask_and_drop)  # not while another lfg is starting a run
        except NoTerminal:
            say('!', 'Removing lfg needs your Mac password', 'run lfg uninstall in Terminal', style=colour(AMBER))
            aside('It takes out the no-password rule first.')
            return 1
        except KeyboardInterrupt:
            print()
            say('·', 'Stopped', 'nothing removed', style='2')
            return 130
        if code:
            return code
    me = os.path.realpath(os.path.join(SHARE, 'lfg'))
    places = [os.path.join(HOME, '.local', 'bin'), '/opt/homebrew/bin', '/usr/local/bin', os.path.join(HOME, 'bin')]
    for d in os.environ.get('PATH', '').split(':') + places:  # the installer's choices, wherever this runs from
        p = os.path.join(d, 'lfg')
        if d and os.path.islink(p) and os.path.realpath(p) == me:
            os.unlink(p)
    shutil.rmtree(SHARE, ignore_errors=True)
    shutil.rmtree(STATE, ignore_errors=True)
    say('✓', 'lfg is removed')
    return 0


def off_free(s):
    """`lfg off` in no-password mode: no password, and the screen lock is not touched."""
    if s['kind'] == 'off':
        describe(s)
        return 0
    with Busy():
        new = turn_off_free()
    if not new['sleep_off']:
        say('✓', 'lfg is off · the Mac can sleep again')
        return 0
    say('!', 'Turned off, but lid sleep is still off', "the rule didn't work", style=colour(AMBER))
    aside('lfg setup --undo takes the rule out and turns lid sleep back on.')
    return 1


def act(what, hours, s):
    running = s['kind'] == 'on'
    if what == 'off' and s['free']:
        return off_free(s)
    if what == 'off':
        if s['kind'] == 'off' and not s['lock_left_off']:
            describe(s)
            return 0
        pw = password('Turn lfg off · sleep and your screen lock come back')
        if pw is None:
            return 1
        with Busy():
            new = turn_off(pw)
        del pw
        lock_bad = new['lock_off'] and (new['lock_was'] or 'immediate') != 'off'
        if not new['sleep_off'] and not lock_bad:
            say('✓', 'lfg is off · sleep and the screen lock are back as you had them')
            return 0
        left = [w for w, bad in (('lid sleep is still off', new['sleep_off']),
                                 ('the screen lock is still off', lock_bad)) if bad]
        say('!', 'Turned off, but ' + ' and '.join(left), 'see ~/.lfg/log', style=colour(AMBER))
        return 1

    if running and hours is None:  # plain `lfg` while it is on: say so, offer to extend or stop
        choice = pick(s)
        if choice is None:
            describe(s)
            return 0
        kind, h, _, _ = choice
        if kind == 'leave':
            describe(s)
            return 0
        if kind == 'off':
            return act('off', None, s)
        now = status()  # the list may have been open a while: add to the end as it is NOW
        base = now['until'] if now['kind'] == 'on' else time.time()
        return grow(base + h * 3600)

    if running:
        end = s['until'] + hours * 3600 if what == 'add' else s['now'] + hours * 3600
        if end <= s['until']:
            say('✦', 'Already on until %s' % clock(s['until'], s['now']),
                'later than %s from now · nothing changed · lfg +%g adds time' % (hours_words(hours), hours))
            return 0
        return grow(end)

    hours = hours or DEFAULT_HOURS
    way = 'free' if s['free'] else first_run(s)  # first_run: the one-time question, only in a terminal
    if way == 'stop':
        return 1
    if way == 'free':
        with Busy():
            new = start_free(int(time.time() + hours * 3600))
        return report(new, 'On', 'Could not start lfg')
    end = int(s['now'] + hours * 3600)
    pw = password('lfg · keep the Mac awake with the lid shut until %s (%s)' % (clock(end, s['now']),
                                                                              hours_words(hours)),
                  'Lid sleep was left off by an earlier lfg; this sorts that out too.' if s['kind'] == 'stuck' else '')
    if pw is None:
        return 1
    with Busy():
        new = start(end, pw)
    del pw
    return report(new, 'On', 'Could not start lfg')


def grow(end):
    end = int(end)
    if end - time.time() > MAX_HOURS * 3600:
        say('!', 'That is more than %d hours from now' % MAX_HOURS, 'nothing changed', style=colour(AMBER))
        return 2
    s = status()
    if s['kind'] == 'on' and s['until'] - time.time() > 5:
        return extend(end)
    if s['free']:  # ending this very moment, or already ended: start again, still with no password
        with Busy():
            new = start_free(end)
        return report(new, 'Extended', 'Could not extend')
    # Ending this very moment, or already ended: starting again needs the password.
    why = 'It was just ending, so this needs your password.' if s['kind'] == 'on' else \
        'It ended while you were choosing, so this starts it again.'
    pw = password('Keep the Mac awake until %s' % clock(end, s['now']), why)
    if pw is None:
        return 1
    with Busy():
        new = start(end, pw)
    del pw
    return report(new, 'Extended', 'Could not extend')


